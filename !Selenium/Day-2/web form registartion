from selenium import webdriver
from selenium.webdriver.common.by import By
import time

driver = webdriver.Edge()

driver.get("https://vinothqaacademy.com/demo-site/")

time.sleep(5)


# FIRST NAME
firstname = driver.find_element(By.ID, "vfb-5")
firstname.send_keys("Ramya")

time.sleep(3)


# LAST NAME
lastname = driver.find_element(By.ID, "vfb-7")
lastname.send_keys("Rajangam")

time.sleep(3)


# GENDER
radio = driver.find_element(By.ID, "vfb-31-2")

if not radio.is_selected():
    radio.click()

time.sleep(3)


# COURSES
check1 = driver.find_element(By.ID, "vfb-20-0")
check1.click()

time.sleep(2)

check2 = driver.find_element(By.ID, "vfb-20-1")
check2.click()

time.sleep(2)

check3 = driver.find_element(By.ID, "vfb-20-2")
check3.click()

time.sleep(5)


# ADDRESS
add = driver.find_element(By.ID, "vfb-13-address")
add.send_keys("Chennai")

time.sleep(2)


# APT / SUITE / BUILDING
driver.find_element(
    By.ID,
    "vfb-13-address-2"
).send_keys("Yamuna Street")

time.sleep(2)


# CITY
driver.find_element(
    By.ID,
    "vfb-13-city"
).send_keys("No 8th 17th flr")

time.sleep(2)


# ZIP CODE
driver.find_element(
    By.ID,
    "vfb-13-zip"
).send_keys("600001")

time.sleep(2)


# EMAIL
driver.find_element(
    By.NAME,
    "vfb-14"
).send_keys("selenium@gmail.com")

time.sleep(2)


print("Form filling completed.")
print("Browser will remain open.")

input("Press Enter to close the browser...")

driver.quit()